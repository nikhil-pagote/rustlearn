{
  "name": "Rust Dev",
  "build": {
    "dockerfile": "Containerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/Rust,type=bind",
  "workspaceFolder": "/workspaces/Rust",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "cargo build"
}

FROM ubuntu:24.04

# Prevents apt/debconf from blocking a build on an interactive prompt (e.g.
# tzdata's "Geographic area:" question, pulled in transitively by ca-certificates).
ENV DEBIAN_FRONTEND=noninteractive

# openssh-client: git itself has no SSH implementation — it shells out to `ssh`.
# Without it, pushing to the git@github.com: remote dies with "cannot run ssh:
# No such file or directory", even though devcontainer.json mounts the keys.
# --no-install-recommends is load-bearing here: the recommends pull in X11 libs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git openssh-client build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile default
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup component add rustfmt clippy

# evcxr: a Rust REPL exposed as a Jupyter kernel, so notebooks/*.ipynb can run
# Rust cells. Needs no Python — VS Code's Jupyter extension launches the kernel
# binary directly over ZeroMQ ("raw kernel" mode), and evcxr bundles a pure-Rust
# ZeroMQ, so there's no libzmq/cmake build dependency to add above.
# `--install` writes the kernelspec to /root/.local/share/jupyter/kernels/rust.
# The registry cache is dropped in the same layer: it's ~185MB of crates pulled
# in only to build evcxr, and nothing else in this image needs them.
RUN cargo install --locked evcxr_jupyter \
    && evcxr_jupyter --install \
    && rm -rf /root/.cargo/registry

# Node.js: not needed for Rust itself, but Claude Code MCP plugins launched via
# `npx` (e.g. the context7 plugin: `npx -y @upstash/context7-mcp`) need it —
# without it, `claude mcp list` shows "Failed to connect" (npx: command not found).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/root/.local/bin:${PATH}"

# The repo is bind-mounted from the host, so its files carry the *host* user's
# uid (typically 1000) while this container runs as root. Git refuses to operate
# on a repo owned by another user ("detected dubious ownership") unless the path
# is whitelisted. Baking it into the system config (/etc/gitconfig) fixes this
# for every user of the image with no per-machine setup — a --global entry can't
# be used here because ~/.gitconfig may itself be a read-only bind mount.
RUN git config --system --add safe.directory /workspaces/Rust

# Must match `workspaceFolder` in devcontainer.json (the repo's mount point).
WORKDIR /workspaces/Rust
